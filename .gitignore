# Nebula Debugger repository ignore rules
# The runnable package is distributed from GitHub Releases as a zip asset.
# GitHub regular repositories reject single files over 100MB, so packaged runtime
# binaries are ignored here and should be included only in the Release zip.

# Packaged app large files / runtime files
/Nebula Debugger.exe
/Uninstall Nebula Debugger.exe
/resources/app.asar
/resources/app.asar.unpacked/
/resources/*.bak*
/resources/elevate.exe

# Electron / Chromium packaged runtime files not needed in the source repo
/locales/
/*.dll
/*.pak
/*.bin
/*.dat
/*.ico
/*.json
/LICENSE.electron.txt
/LICENSES.chromium.html

# Release archives and installer artifacts
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.msi
*.nupkg
*.blockmap
*-Setup-*.exe
*-setup-*.exe

# Logs, crash dumps, diagnostics
*.log
logs/
crashpad/
Crashpad/
*.dmp
*.dump
*.tmp
*.temp
*.pid

# Development caches
/.electron/
/.cache/
/.vite/
/dist/
/build/
/out/
/release/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor and OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local environment / secrets
.env
.env.*
*.local
config.local.*
